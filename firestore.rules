rules_version = '2';

// Authorization for Generations. The UI hides things for convenience; these
// rules are what actually protect the data. See docs/ARCHITECTURE.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }

    function isAdmin() {
      return isActive() && profile().role == 'admin';
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }

    // Profile picture: a small square image embedded as a data URL (Cloud
    // Storage needs the paid plan). The app sends 256x256 images of ~15-30 KB;
    // the cap keeps anyone from filling the database with big files.
    function validPhoto(data) {
      return !('photo' in data)
        || (data.photo is string
          && data.photo.size() <= 70000
          && data.photo.matches('data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+'));
    }

    function validUser(data) {
      return data.keys().hasOnly(['email', 'displayName', 'role', 'active', 'createdAt'])
        && data.email is string
        && validName(data.displayName)
        && data.role in ['admin', 'user']
        && data.active is bool
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      // Users can always read their own profile (even when deactivated, so the
      // app can tell them); admins can read everyone.
      allow get: if (verified() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();

      // Self-registration: a verified user creates their own profile, always as
      // a normal user waiting for approval (inactive) until an admin activates
      // it. Admins can create profiles for others (active or not).
      allow create: if validUser(request.resource.data) && (
        (verified()
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'user'
          && request.resource.data.active == false)
        || (isAdmin() && request.auth.uid != userId)
      );

      // Active users edit their own name and picture (never email, role or
      // status). Admins change other users' name, role and status, never their
      // own role or status.
      allow update: if (
          isActive()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photo'])
          && validName(request.resource.data.displayName)
          && validPhoto(request.resource.data)
        ) || (
          isAdmin()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'active'])
          && validName(request.resource.data.displayName)
          && request.resource.data.role in ['admin', 'user']
          && request.resource.data.active is bool
        );

      // No deletes: without the Admin SDK the Auth account would remain, and the
      // user could recreate their profile. Deactivate instead.
      allow delete: if false;
    }

    // Family tree: each user owns one tree, trees/{uid}/people/{personId}; their
    // own card has personId == uid. Only the owner (active) can use it.
    // ponytail: plaintext for now; browser-side encryption replaces these
    // fields with one encrypted blob in a later step.
    function optText(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function optDate(data, key) {
      return !(key in data) || (data[key] is string && data[key].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    function optIds(data, key, max) {
      return !(key in data) || (data[key] is list && data[key].size() <= max);
    }

    function validPerson(data) {
      return data.keys().hasOnly(['name', 'gender', 'birth', 'death', 'anniversary', 'email', 'address',
          'socials', 'parents', 'children', 'spouses', 'siblings', 'photos', 'updatedAt'])
        && validName(data.name)
        && (!('gender' in data) || data.gender in ['male', 'female', 'other'])
        && optDate(data, 'birth') && optDate(data, 'death') && optDate(data, 'anniversary')
        && optText(data, 'email', 254) && optText(data, 'address', 500)
        && (!('socials' in data) || (data.socials is list && data.socials.size() <= 10))
        && optIds(data, 'parents', 2) && optIds(data, 'children', 50)
        && optIds(data, 'spouses', 10) && optIds(data, 'siblings', 50)
        && optIds(data, 'photos', 5)
        && data.updatedAt == request.time;
    }

    match /trees/{ownerId}/people/{personId} {
      allow read, delete: if isActive() && request.auth.uid == ownerId;
      allow create, update: if isActive() && request.auth.uid == ownerId && validPerson(request.resource.data);
    }

    // Up to 5 photos per person: the id is "{personId}_{0-4}", so there are only
    // five possible documents. Each is a small WebP/JPEG data URL (the app
    // sends 480 px images of ~20-40 KB; Cloud Storage needs the paid plan).
    function validTreePhoto(data) {
      return data.keys().hasOnly(['data', 'updatedAt'])
        && data.data is string
        && data.data.size() <= 100000
        && data.data.matches('data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+')
        && data.updatedAt == request.time;
    }

    match /trees/{ownerId}/photos/{photoId} {
      allow read, delete: if isActive() && request.auth.uid == ownerId;
      allow create, update: if isActive() && request.auth.uid == ownerId
        && photoId.matches('[A-Za-z0-9]+_[0-4]')
        && validTreePhoto(request.resource.data);
    }

    // Everything else is denied until a feature defines its own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
