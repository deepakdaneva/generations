{
  "name": "generations",
  "version": "0.4.0",
  "author": "Deepak Kumar Jangir",
  "homepage": "https://github.com/deepakdaneva/generations",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "node scripts/emulators-exec.mjs \"npm start\" --only auth,firestore --ui --import=./emulator-data --export-on-exit=./emulator-data",
    "seed": "node scripts/seed-emulators.mjs",
    "build": "ng build",
    "deploy:uat": "npm run build && firebase deploy --project uat --only hosting,firestore",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:rules": "node scripts/emulators-exec.mjs \"vitest run --dir tests/rules\" --only firestore",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@capacitor/core": "8.6.0",
    "@ionic/angular": "^9.0.0",
    "elkjs": "0.12.0",
    "firebase": "13.1.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/cli": "8.6.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "firebase-tools": "15.34.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~5.0.5"
  },
  "prettier": "@ionic/prettier-config",
  "description": "Build, maintain and explore your family tree.",
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "uuid": "^11.1.1"
  }
}
